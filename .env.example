# Compass login credentials
COMPASS_EMAIL=
COMPASS_PASSWORD=

# Shared collection URL from your realtor (optional if using LISTING_URLS).
# Only the collection ID is used; the tab segment (/matches, /favorites) is
# validated but does NOT select what gets fetched -- COMPASS_COLLECTION_TABS
# does. A URL naming the /notInterested tab is rejected outright.
COMPASS_COLLECTION_URL=

# Which tabs of that collection to scrape, comma-separated.
# Defaults to: favorites,matches  (favorites wins when a listing is in both)
# Valid names: matches, favorites. notInterested is never scrapeable.
COMPASS_COLLECTION_TABS=

# Comma-separated individual listing URLs (optional if using COMPASS_COLLECTION_URL)
LISTING_URLS=

# Cloud sync (publish.py) -- pushes the local DB + photos to the hosted viewer
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
BLOB_READ_WRITE_TOKEN=
SHORT_LIST_URL=
REVALIDATE_SECRET=

# Photos hosted per listing in Vercel Blob. 0 (the default) means no cap.
# Set a small number only if you are on a plan where Advanced Operations
# are scarce -- each photo is one operation.
MAX_PHOTOS_PER_LISTING=
