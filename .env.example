# Compass login credentials
COMPASS_EMAIL=
COMPASS_PASSWORD=

# Shared collection URL from your realtor (optional if using LISTING_URLS).
# Only the collection ID is used; the tab segment (/matches, /favorites) is
# validated but does NOT select what gets fetched -- COMPASS_COLLECTION_TABS
# does. A URL naming the /notInterested tab is rejected outright.
COMPASS_COLLECTION_URL=

# Which tabs of that collection to scrape, comma-separated.
# Defaults to: favorites,matches  (favorites wins when a listing is in both)
# Valid names: matches, favorites. notInterested is never scrapeable.
COMPASS_COLLECTION_TABS=

# Comma-separated individual listing URLs (optional if using COMPASS_COLLECTION_URL)
LISTING_URLS=

# The hosted viewer's data. The pipeline stages write Turso and Blob
# directly, then POST revalidate so short-list drops its cached reads.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
BLOB_READ_WRITE_TOKEN=
SHORT_LIST_URL=
REVALIDATE_SECRET=

# Mapbox access token, scoped to Directions and Geocoding only. Required by
# the commutes stage in BOTH execution homes -- the desktop reads it here,
# and short-list passes it into the sandbox from the project environment.
# The stage exits 2 naming this variable if it is absent.
MAPBOX_ACCESS_TOKEN=

# Photos hosted per listing in Vercel Blob. 0 (the default) means no cap.
# Set a small number only if you are on a plan where Advanced Operations
# are scarce -- each photo is one operation.
MAX_PHOTOS_PER_LISTING=

# Local-home only, for `python ops/state.py push|pull`. Read-write token for
# the PRIVATE Blob store holding compass_state.json -- a Compass session
# behind a public URL is a credential anyone with the link can replay.
# (The photo-scoring checkpoint used to live here too; it is in Turso now.)
# Distinct from BLOB_READ_WRITE_TOKEN above, which points at the public
# store serving listing photos: private access is a store-level setting, so
# the two cannot share one store. Create with
#   vercel blob create-store home-search-state --access private
# In production short-list holds this instead, and neither the launcher nor
# the reaper passes it into the sandbox: the runner never touches state/.
BLOB_STATE_READ_WRITE_TOKEN=

# Optional. ntfy.sh topic for pipeline failure notifications. Unset means no
# notifications, which is exactly today's behaviour. The topic name IS the
# credential -- anyone who knows it can publish to it and subscribe to it --
# so use an unguessable string, not "home-search".
NTFY_TOPIC=
