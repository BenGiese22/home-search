[Unit]
Description=home-search pipeline (scrape, score, publish)
Documentation=file:///home/bengi/code/home-search/ops/systemd/README.md
# Every stage talks to the network; starting before DNS is up just wastes a run.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Load-bearing: every script resolves data/ and .env relative to cwd.
WorkingDirectory=/home/bengi/code/home-search
# Nothing in the pipeline shells out to an external CLI any more -- photo
# upload used to require the `vercel` binary on PATH, and now goes straight
# to the Blob REST API. This is just a sane default PATH; the venv entry is
# what stage subprocesses resolve `python` through.
Environment=PATH=/home/bengi/code/home-search/venv/bin:/usr/local/bin:/usr/bin:/bin
# --max-age=5h makes the several triggers below idempotent: whichever fires
# first does the work, the rest find a recent success and exit 0. Slightly
# under the 6h interval so a scheduled run is never skipped by rounding.
ExecStart=/home/bengi/code/home-search/venv/bin/python pipeline.py --max-age=5h
# A photo-scoring batch can legitimately run for hours; do not kill it.
TimeoutStartSec=6h
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=default.target
